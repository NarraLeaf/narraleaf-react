# Node.js dependencies
# No trailing slash on purpose: with one, this matches a DIRECTORY only, and a worktree that
# links its dependencies from a sibling checkout has a node_modules SYMLINK instead. git then
# treats it as an ordinary file and `git add -A` commits it — a 120000 blob holding one
# machine's absolute path. Checking that out replaces a real install with a link to itself.
node_modules
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# Production build
/dist/

# TypeScript
*.tsbuildinfo
tsconfig.dts-check.json

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Webpack output
/webpack-stats.json

# Log files
*.log

# IDE specific files
.vscode/
.idea/

# macOS specific
.DS_Store

# Windows specific
Thumbs.db

# Project specific
./test/
dev.json
.ignore/

*-example.test.tsx
*-ignore.test.js
